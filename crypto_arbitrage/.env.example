# CryptoArbitrage Environment Configuration
# V2.3 - Production Deployment

# ========================================
# System Configuration
# ========================================
SYSTEM_MODE=simulation  # simulation, paper_trading, live_trading
LOG_LEVEL=INFO

# ========================================
# Exchange API Keys
# ========================================
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=false

# OKX
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_TESTNET=false

# Huobi (optional)
HUOBI_API_KEY=your_huobi_api_key_here
HUOBI_SECRET=your_huobi_secret_here
HUOBI_TESTNET=false

# ========================================
# Memo0 Configuration
# ========================================
MEM0_API_KEY=your_mem0_api_key_here
MEM0_USER_ID=crypto-arbitrage-user
MEM0_AGENT_ID=trading-bot

# ========================================
# AI Model Configuration
# ========================================
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-5-20250929
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096

# ========================================
# Monitoring & Alerting
# ========================================
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_RETENTION=15d

# ========================================
# Redis Cache (optional)
# ========================================
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ========================================
# Telegram Notifications
# ========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========================================
# Email Notifications
# ========================================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=trader@example.com
EMAIL_TO=trader@example.com

# ========================================
# Webhook Notifications
# ========================================
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/alerts
WEBHOOK_METHOD=POST

# ========================================
# Risk Management
# ========================================
MAX_DAILY_LOSS=500
MAX_POSITION_SIZE=1000
MAX_TOTAL_EXPOSURE=5000
MAX_DRAWDOWN=10.0
BASE_STOP_LOSS=2.0
BASE_TAKE_PROFIT=1.0
TRAILING_STOP=0.5
RISK_REWARD_RATIO=2.0

# ========================================
# Strategy Parameters
# ========================================
MIN_OPPORTUNITY_SCORE=60
MAX_CONCURRENT_TRADES=3
SCAN_INTERVAL=30
TRADE_TIMEOUT=60

# ========================================
# Performance Optimization
# ========================================
MAX_WORKERS=4
CACHE_TTL=300
CONNECTION_POOL_SIZE=10
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=5

# ========================================
# Docker Configuration
# ========================================
DOCKER_CPUS=2
DOCKER_MEMORY=4G
DOCKER_DISK_SIZE=20G

# ========================================
# Backup Configuration
# ========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=/app/backups

# ========================================
# Security
# ========================================
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=*
DEBUG=false
